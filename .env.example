# Обязательное на боевом сервере
NODE_ENV=production
ADMIN_KEY=                      # пароль админки, не короче 16 символов, придумайте длинный
PUBLIC_URL=https://example.com  # адрес сайта с https, без слеша в конце
DATA_DIR=/data                  # постоянный диск: архив дел, статистика сезона, ключ подписи сессий

# Почта для связи: видна в подвале, на странице «Контакты» и в документах
CONTACT_EMAIL=detective-platform-ops@proton.me

# Сообщество
DISCORD_SERVER_URL=https://discord.gg/hfWsKkGVH   # приглашение на сервер: строка на главной и ссылка в контактах

# Вход через Discord и Google (можно позже, без них играют по нику)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Необязательное
PORT=3000
SESSION_SECRET=                 # без него создаётся DATA_DIR/session.key
MAX_ROOMS=500                   # сколько комнат держать одновременно
ROOMS_PER_IP=3                  # открытых комнат с одного IP
ROOMS_NEW_PER_IP=10             # новых комнат с одного IP за 10 минут
MAX_CONN_PER_IP=30              # подключений с одного адреса
HTTP_PER_IP=600                 # запросов к сайту с одного адреса за 10 минут
TRUST_PROXY_HOPS=1              # сколько прокси перед сервером (Render, Railway, Fly: 1)
